        "hide": 0,
        "includeAll": true,
        "label": "Severity",
        "multi": true,
        "name": "severity",
        "options": [
          { "selected": true, "text": "All", "value": "$__all" },
          { "selected": false, "text": "1", "value": "1" },
          { "selected": false, "text": "2", "value": "2" },
          { "selected": false, "text": "3", "value": "3" }
        ],
        "query": "1,2,3",
        "queryValue": "",
        "skipUrlSync": false,
        "type": "custom"
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "title": "Suricata alerts",
  "uid": "axr-suricata-alerts",
